function y = sin_fixed(theta)
    assert(isa(theta,'int32'),'Error! input must be type int32');

    ONE_BY_THREE_FACTORIAL  =   int32(0.16666666666*4096);
    ONE_BY_FIVE_FACTORIAL   =   int32(0.00833333333*4096);
    HALF_PI                 =   int32(1.57079632679);
    PI                      =   3.14159265359;
    THREE_BY_TWO_PI         =   4.71238898038;
    TWO_PI                  =   6.28318530718;
    
    
end