%Inputs: 
%    iq, id, desired
%    sth, cth measured
%    IMPORTANT NOTE:    
%        Fixed point range of iq and id is -2^15 to 2^15, but the nature of
%        inverse park + svm means the true range is sqrt(3)/2*2^1
%   
%       
%   
function [ialpha,ibeta] = inverse_park_fixed(iq,id,sth,cth)
    assert(isa(iq,'int32') & isa(id,'int32') & isa(sth,'int32') & isa(cth,'int32'),'Error: input must be type int32');
    iq_n = 15;  %This specifies the range for iq-id. 
    %NOTE: 
    %every term is equal to TERM*4096, from the fixed point scaling we 
    %enforce throughout. We need to apply bitshifts where approprite to
    %compensate
    ialpha = bitshift((id*cos_theta - iq*sin_theta), -iq_n);
    ibeta = bitshift(id*sin_theta,-12) + bitshift(iq*cos_theta,-iq_n);
end