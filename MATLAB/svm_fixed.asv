% INPUTS:
    %alpha, beta. FOR NOW ASSUME 2^12 RANGE.
    %period_cnt, the timer period range
%
function [tA,tB,tC] = svm_fixed(alpha,beta,period_cnt)
    assert(isa(alpha,'int32') & isa(beta,'int32') & isa(period_cnt,'int32'),'Error: inputs must be type int32');   
    n_alpha_beta = 12; %this could be higher, and an input. Experiment later
    pwm_half_period = period_cnt;
    SQRT_3 = int32(sqrt(3)*2^n_alpha_beta);
    TWO_BY_SQRT_3 = int32( (2/sqrt(3))*2^n_alpha_beta );
    ONE_BY_SQRT_3 = int32( (1/sqrt(3))*2^n_alpha_beta );
    alpha_sqrt3 = bitshift(alpha*SQRT_3,-n_alpha_beta);
    
    if(beta >= 0)	%%quadrant 1 or two
        if(alpha >= 0)	%quadrant 1
            if(beta <= alpha_sqrt3)	%sector 1
				sector = 1;
			else							%sector 2
				sector = 2;
            end
		else				%quadrant 2
            if(beta <= -alpha_sqrt3)	%sector 2
				sector = 3;
			else							%sector 3
				sector = 2;
            end
        end
	else			%%quadrant 3 or 4
        if(alpha >= 0)	%quadrant 4
            if(beta < -alpha_sqrt3)
				sector = 5;
			else
				sector = 6;
            end
		else				%quadrant 3
            if(beta < alpha_sqrt3)
				sector = 5;
			else
				sector = 4;
		 
            end
        end
    end
            
	switch (sector)
	case 1
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3*beta,-n_alpha_beta);
        two_by_sqrt3_beta = bitshift(TWO_BY_SQRT_3 * beta,-n_alpha_beta);
        
		t1 = bitshift(((alpha - beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		t2 = bitshift(((two_by_sqrt3_beta) * pwm_half_period), -n_alpha_beta);
		tA = bitshift((pwm_half_period - t1 - t2),-1);
		tB = tA + t1;
		tC = tB + t2;
		
	case 2
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3 * beta , -n_alpha_beta);
		t2 = bitshift(((alpha + beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		t3 = bitshift(((-alpha + ONE_BY_SQRT_3 * beta) * pwm_half_period),-n_alpha_beta);
		tB = bitshift((pwm_half_period - t2 - t3),-1);
		tA = tB + t3;
		tC = tA + t2;
		
	 
	case 3
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3*beta,-n_alpha_beta);
        two_by_sqrt3_beta = bitshift(TWO_BY_SQRT_3 * beta,-n_alpha_beta);

		t3 = bitshift(((two_by_sqrt3_beta) * pwm_half_period),-n_alpha_beta);
		t4 = bitshift(((-alpha - beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		tB = bitshift((pwm_half_period - t3 - t4),-1);
		tC = tB + t3;
		tA = tC + t4;
		
	 
	case 4
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3*beta,-n_alpha_beta);
        two_by_sqrt3_beta = bitshift(TWO_BY_SQRT_3 * beta,-n_alpha_beta);
	 
		t4 = bitshift(((-alpha + beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		t5 = bitshift(((-two_by_sqrt3_beta) * pwm_half_period),-n_alpha_beta);
		tC = (pwm_half_period - t4 - t5) / 2;
		tB = tC + t5;
		tA = tB + t4;

	case 5
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3*beta,-n_alpha_beta);
        
		t5 = bitshift(((-alpha - beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		t6 = bitshift(((alpha - beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		tC = (pwm_half_period - t5 - t6) / 2;
		tA = tC + t5;
		tB = tA + t6;
		
	 
	case 6
        beta_by_sqrt3 = bitshift(ONE_BY_SQRT_3*beta,-n_alpha_beta);
        two_by_sqrt3_beta = bitshift(TWO_BY_SQRT_3 * beta,-n_alpha_beta);

		t6 = bitshift(((-two_by_sqrt3_beta) * pwm_half_period),-n_alpha_beta);
		t1 = bitshift(((alpha + beta_by_sqrt3) * pwm_half_period),-n_alpha_beta);
		tA = (pwm_half_period - t6 - t1) / 2;
		tC = tA + t1;
		tB = tC + t6;
		
% 	gl_sector = sector;
% 	return sector;
end